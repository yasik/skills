{
  "name": "create-kb-operator",
  "version": "0.1.0",
  "description": "Interactive installer for a kb-operator knowledge base: scaffolds the KB, installs the Claude Code / Codex plugin, and wires up qmd search — with sensible defaults.",
  "bin": {
    "create-kb-operator": "./bin/create-kb-operator.mjs"
  },
  "type": "module",
  "scripts": {
    "format": "biome format --write bin",
    "lint": "biome check --error-on-warnings bin",
    "prepack": "mkdir -p assets && cp -f ../skills/kb-ingest/references/schema-template.md assets/schema-template.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0"
  },
  "files": [
    "bin",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "knowledge-base",
    "obsidian",
    "claude-code",
    "codex",
    "qmd",
    "kb-operator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yasik/skills",
    "directory": "plugins/kb-operator/installer"
  },
  "license": "MIT"
}
